{
  "name": "remotion-album",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AlbumStack: five cards fly in, the hero clip expands full frame, the CRT dies and the Token outro holds for 5s. 1920x1080 @ 60fps.",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "compositions": "remotion compositions src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "render": "node render.mjs out/AlbumStack.mp4 --no-alpha",
    "render:mp4": "node render.mjs out/AlbumStack.mp4 --no-alpha",
    "render:alpha": "node render.mjs out/AlbumStackAlpha.mov",
    "font:build": "node scripts/build-font.mjs"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.509",
    "@remotion/media": "4.0.509",
    "@remotion/renderer": "4.0.509",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remotion": "4.0.509"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.509",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
